{%- doc -%}
  "Size chart" button shown in the Product information section.

  It stays hidden (CSS) until the size-chart section finds a chart and adds
  the has-size-chart class to <html>. Clicks are handled by the size-chart
  section through event delegation, so the button keeps working after Dawn
  re-renders the product info on a variant change.

  @param {string} label - Button text
  @param {object} block - The block, for theme editor attributes

  @example
  {% render 'size-chart-trigger', label: block.settings.label, block: block %}
{%- enddoc -%}

{{ 'component-size-chart.css' | asset_url | stylesheet_tag }}
<div class="size-chart-trigger" {{ block.shopify_attributes }}>
  <button type="button" class="size-chart-trigger__button link" data-size-chart-open aria-haspopup="dialog">
    <span class="svg-wrapper size-chart-trigger__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" width="20" height="20">
        <rect x="1.5" y="6" width="17" height="8" rx="1" stroke="currentColor" stroke-width="1.2"/>
        <path d="M5 6v3M8 6v2M11 6v3M14 6v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    </span>
    {{ label | escape }}
  </button>
</div>
