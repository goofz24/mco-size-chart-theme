{%- comment -%}
  Size chart section (product pages).

  Where the data comes from, in order:
  1. The product metafield custom.size_chart (a reference to a "Size chart" metaobject).
  2. The "Fallback size chart" picked in this section's settings.
  If neither exists, the section renders nothing for shoppers.

  Metaobject type: size_chart, with fields name, unit ("in" or "cm"), chart (JSON) and fit_note.
  See docs/metafields.md for the definitions and an example chart.
{%- endcomment -%}

{%- liquid
  assign size_chart = product.metafields.custom.size_chart.value
  assign chart_source = 'product'
  if size_chart == blank
    assign size_chart = section.settings.fallback_chart
    assign chart_source = 'fallback'
  endif

  assign chart_data = size_chart.chart.value
  assign has_chart = false
  if chart_data.columns.size > 0 and chart_data.rows.size > 0
    assign has_chart = true
  endif

  assign source_unit = size_chart.unit.value | strip | downcase
  if source_unit != 'cm'
    assign source_unit = 'in'
  endif

  assign default_unit = section.settings.default_unit
  if default_unit == 'source'
    assign default_unit = source_unit
  endif

  # 1-based position of the size option (0 = the product has no size option).
  assign size_option_position = 0
  assign size_option_names = section.settings.size_option_names | downcase | split: ','
  for option in product.options_with_values
    assign option_name = option.name | strip | downcase
    assign option_position = forloop.index
    for wanted_name in size_option_names
      assign wanted = wanted_name | strip
      if wanted != blank and option_name == wanted and size_option_position == 0
        assign size_option_position = option_position
      endif
    endfor
  endfor

  assign size_option_index = size_option_position | minus: 1
  assign initial_size = ''
  if size_option_position > 0
    assign initial_size = product.selected_or_first_available_variant.options[size_option_index]
  endif

  assign chart_name = size_chart.name.value | default: section.settings.heading
  assign dialog_id = 'SizeChartDialog-' | append: section.id
  assign heading_id = 'SizeChartHeading-' | append: section.id
-%}

{%- if has_chart -%}
  {{ 'component-size-chart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'size-chart.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <size-chart
    class="size-chart size-chart--{{ section.settings.display }}"
    data-display="{{ section.settings.display }}"
    data-source-unit="{{ source_unit }}"
    data-default-unit="{{ default_unit }}"
    data-option-index="{{ size_option_index }}"
    data-initial-size="{{ initial_size | escape }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-chart-name="{{ chart_name | escape }}"
    data-chart-source="{{ chart_source }}"
    data-label-in="{{ 'sections.size_chart.caption_unit_in' | t | escape }}"
    data-label-cm="{{ 'sections.size_chart.caption_unit_cm' | t | escape }}"
  >
    <script type="application/json" data-size-chart-variants>
      {{ product.variants | map: 'id' | json }}
    </script>

    {%- capture chart_body -%}
      <div class="size-chart__header">
        <h2 id="{{ heading_id }}" class="size-chart__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
        {%- if section.settings.show_unit_toggle -%}
          <div class="size-chart__units" role="group" aria-label="{{ 'sections.size_chart.unit_toggle_label' | t }}">
            <button type="button" class="size-chart__unit-button" data-size-chart-unit="in" aria-pressed="{% if source_unit == 'in' %}true{% else %}false{% endif %}">
              {{- 'sections.size_chart.inches' | t -}}
            </button>
            <button type="button" class="size-chart__unit-button" data-size-chart-unit="cm" aria-pressed="{% if source_unit == 'cm' %}true{% else %}false{% endif %}">
              {{- 'sections.size_chart.centimeters' | t -}}
            </button>
          </div>
        {%- endif -%}
      </div>

      {% render 'size-chart-table',
        chart_data: chart_data,
        source_unit: source_unit,
        caption: chart_name,
        section_id: section.id
      %}

      {%- assign fit_note = size_chart.fit_note.value -%}
      {%- if fit_note != blank -%}
        <p class="size-chart__fit-note">{{ fit_note | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="size-chart__tips">
          {%- for block in section.blocks -%}
            <div class="size-chart__tip" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 240
                  | image_tag: class: 'size-chart__tip-image', loading: 'lazy', widths: '120, 240', sizes: '120px'
                }}
              {%- endif -%}
              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="size-chart__tip-title h5">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                <div class="size-chart__tip-text rte">{{ block.settings.text }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.display == 'modal' -%}
      <dialog id="{{ dialog_id }}" class="size-chart__dialog color-{{ section.settings.color_scheme }} gradient" aria-labelledby="{{ heading_id }}">
        <div class="size-chart__dialog-inner">
          <button type="button" class="size-chart__close" data-size-chart-close aria-label="{{ 'accessibility.close' | t }}">
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
          {{ chart_body }}
        </div>
      </dialog>
    {%- else -%}
      <div class="page-width section-{{ section.id }}-padding">
        <div class="size-chart__inline color-{{ section.settings.color_scheme }} gradient">
          {{ chart_body }}
        </div>
      </div>
    {%- endif -%}
  </size-chart>
{%- elsif request.design_mode -%}
  <div class="page-width">
    <p class="size-chart__editor-notice">{{ 'sections.size_chart.editor_notice' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Size chart",
  "tag": "section",
  "class": "section size-chart-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the size chart linked to the product's \"custom.size_chart\" metafield. Add a \"Size chart button\" block to the Product information section to open it."
    },
    {
      "type": "metaobject",
      "id": "fallback_chart",
      "label": "Fallback size chart",
      "metaobject_type": "size_chart",
      "info": "Used when a product has no size chart of its own."
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        { "value": "modal", "label": "Pop-up (opened by the size chart button)" },
        { "value": "inline", "label": "On the page" }
      ],
      "default": "modal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size chart"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_unit_toggle",
      "label": "Show inches / centimeters switch",
      "default": true
    },
    {
      "type": "select",
      "id": "default_unit",
      "label": "Unit shown first",
      "options": [
        { "value": "source", "label": "Same as the chart" },
        { "value": "in", "label": "Inches" },
        { "value": "cm", "label": "Centimeters" }
      ],
      "default": "source"
    },
    {
      "type": "text",
      "id": "size_option_names",
      "label": "Size option names",
      "default": "Size, Talla",
      "info": "Comma-separated. The variant option with one of these names highlights the matching row."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding (on the page only)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "measure_tip",
      "name": "How to measure tip",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Chest"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Measure around the fullest part of your chest, keeping the tape level.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size chart"
    }
  ]
}
{% endschema %}
